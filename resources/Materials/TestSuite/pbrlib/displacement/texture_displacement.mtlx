<?xml version="1.0"?>
<materialx version="1.39">
  <!-- Texture-based displacement test: uses image node to sample a texture for displacement -->
  <standard_surface name="surf" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.4, 0.2" />
    <input name="specular_roughness" type="float" value="0.4" />
  </standard_surface>
  <texcoord name="texcoord1" type="vector2" />
  <image name="heightmap" type="float">
    <input name="file" type="filename" value="resources/Images/grid.png" />
    <input name="texcoord" type="vector2" nodename="texcoord1" />
  </image>
  <displacement name="disp1" type="displacementshader">
    <input name="displacement" type="float" nodename="heightmap" />
    <input name="scale" type="float" value="0.5" />
  </displacement>
  <surfacematerial name="texdisp_mat" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="surf" />
    <input name="displacementshader" type="displacementshader" nodename="disp1" />
  </surfacematerial>
</materialx>
